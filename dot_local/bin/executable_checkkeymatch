#!/bin/sh
if [ -z "$1" ] || [ -z "$2" ]; then
  echo "Usage: checkkeymatch <cert> <key>" >&2
  exit 1
fi

certmd5=$(openssl x509 -noout -modulus -in "$1" | openssl md5)
keymd5=$(openssl rsa -noout -modulus -in "$2" | openssl md5)

echo "md5sum Certificate: $certmd5"
echo "md5sum Key: $keymd5"

if [ "$certmd5" = "$keymd5" ]; then
  echo "==> md5sum of Key and Certificate are matching."
else
  echo "==> md5sum of Key and Certificate are NOT matching."
fi
