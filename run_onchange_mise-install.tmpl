#!/bin/bash
{{- $nixos := false }}
{{- if hasKey .chezmoi "osRelease" }}{{ $nixos = eq (trimAll "'\"" .chezmoi.osRelease.id) "nixos" }}{{ end }}
{{- if $nixos }}
exit 0
{{- end }}
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
MISE="$HOME/.local/bin/mise"

if ! command -v mise >/dev/null 2>&1 && [[ ! -x "$MISE" ]]; then
  echo "mise not found – installing..."
  curl https://mise.run | sh
else
  echo "mise already installed – skipping installation."
fi

"$MISE" install -y
